{
    "name": "kimetra",
    "version": "2.1.1",
    "description": "Keyboard and mouse automation for Node.js on Windows, macOS and Linux (X11 and Wayland). Prebuilt, zero dependencies.",
    "main": "./src/kimetra.js",
    "types": "./index.d.ts",
    "bin": {
        "kimetra": "./bin/cli.js"
    },
    "gypfile": false,
    "exports": {
        ".": {
            "types": "./index.d.ts",
            "import": "./index.mjs",
            "require": "./src/kimetra.js"
        }
    },
    "author": {
        "name": "Saad",
        "email": "saad.devx@gmail.com",
        "url": "https://github.com/saad-devx"
    },
    "scripts": {
        "test": "node scripts/test.js",
        "bench": "node bench/bench.js",
        "prepack": "npm test",
        "postinstall": "node scripts/post-install.js"
    },
    "keywords": [
        "kimetra",
        "keyboard",
        "mouse",
        "automation",
        "keystroke",
        "hotkeys",
        "macro",
        "simulation",
        "input",
        "native",
        "cross-platform",
        "windows",
        "macos",
        "linux",
        "wayland",
        "uinput",
        "sendinput",
        "coregraphics",
        "robotjs",
        "nut.js",
        "xdotool",
        "cli"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/saad-devx/kimetra.git"
    },
    "bugs": {
        "url": "https://github.com/saad-devx/kimetra/issues"
    },
    "homepage": "https://github.com/saad-devx/kimetra#readme",
    "engines": {
        "node": ">=16.0.0"
    },
    "os": [
        "win32",
        "darwin",
        "linux"
    ],
    "files": [
        "index.mjs",
        "index.d.ts",
        "bin/cli.js",
        "src/bin",
        "src/core",
        "src/kimetra.js",
        "scripts/post-install.js",
        "CHANGELOG.md"
    ]
}
